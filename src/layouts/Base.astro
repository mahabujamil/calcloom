---
import '@fontsource/cairo/latin-400.css';
import '@fontsource/cairo/latin-600.css';
import '@fontsource/cairo/latin-800.css';
import '@fontsource/cairo/arabic-400.css';
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-800.css';
import { ui, localePath, BASE, type Lang } from '../i18n';
import { allTools } from '../data/get';
import { cats, meta, type Cat } from '../data/meta';
import { ucats, pairs, pairSlug } from '../data/units';
import { fxPairs, fxSlug } from '../data/extra2';
import { extraSlugs } from '../data/extra';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  schema?: object[];
  noindex?: boolean;
}
const { title, description, lang = "en", schema = [], noindex = false } = Astro.props;
const t = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// English path of the current page, used to build both language URLs
const enPath = Astro.url.pathname.slice(BASE.length).replace(/^\/ar(?=\/|$)/, '') || '/';
const href = (l: Lang) => new URL(localePath(l, enPath), Astro.site).href;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const ogImage = new URL(`${BASE}/og.png`, Astro.site).href;
const footTools = allTools(lang).filter((x) => x.kind !== 'pair');
const GA_ID = 'G-LVY865ZX9M';
const themeLabel = lang === 'ar' ? { toLight: 'الوضع الفاتح', toDark: 'الوضع الداكن' } : { toLight: 'Light mode', toDark: 'Dark mode' };
const sunMoon = '<svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>';
const catIcon: Record<string, string> = {
  convert: '<path d="M3 17L17 3l4 4L7 21z"/><path d="M7 13l2 2M10 10l2 2M13 7l2 2"/>',
  money: '<path d="M3 10l9-6 9 6"/><path d="M5 10v8M9 10v8M15 10v8M19 10v8"/><path d="M3 20h18"/>',
  health: '<path d="M3 12h4l2-5 4 10 2-5h6"/>',
  time: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  daily: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/>',
  tools: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 118 0v3"/>',
};
const ar = lang === 'ar';
const calcCats = (['money', 'health', 'time', 'daily', 'tools'] as Cat[]).map((c) => ({ id: c, name: ar ? cats[c].ar : cats[c].en, icon: catIcon[c] }));
const conv = [
  { slug: 'length-converter', label: ar ? 'تحويل الأطوال' : 'Length converter' },
  { slug: 'km-to-miles', label: ar ? 'تحويل المسافات (كم ↔ ميل)' : 'Distance (km ↔ miles)' },
  { slug: 'weight-converter', label: ar ? 'تحويل الوزن' : 'Weight converter' },
  { slug: 'currency-converter', label: ar ? 'تحويل العملات' : 'Currency converter' },
  { slug: 'temperature-converter', label: ar ? 'تحويل الحرارة' : 'Temperature converter' },
  { slug: 'volume-converter', label: ar ? 'تحويل الحجم' : 'Volume converter' },
  { slug: 'kg-to-liters-converter', label: ar ? 'تحويل الكيلو إلى لتر' : 'Kilograms to litres' },
  { slug: 'area-converter', label: ar ? 'تحويل المساحات' : 'Area converter' },
  { slug: 'speed-converter', label: ar ? 'تحويل السرعة' : 'Speed converter' },
  { slug: 'time-converter', label: ar ? 'تحويل الوقت' : 'Time converter' },
  { slug: 'fuel-economy-converter', label: ar ? 'تحويل استهلاك الوقود' : 'Fuel economy converter' },
  { slug: 'data-storage-converter', label: ar ? 'تحويل التخزين الرقمي' : 'Data storage converter' },
  { slug: 'pressure-converter', label: ar ? 'تحويل الضغط' : 'Pressure converter' },
  { slug: 'energy-converter', label: ar ? 'تحويل الطاقة' : 'Energy converter' },
].filter((x) => meta[x.slug]);
const here = Astro.url.pathname;
// Sidebar groups: every converter family and calculator category opens into its own pages.
const byS = new Map(allTools(lang).map((x) => [x.slug, x]));
const nm = (sl: string) => byS.get(sl)?.name ?? sl;
const convLabel = new Map(conv.map((c) => [c.slug, c.label]));
const famItems: Record<string, string[]> = {};
for (const c of ucats) famItems[c.slug] = pairs.filter((q) => q[0] === c.id).map((q) => pairSlug(...q)).filter((x) => byS.has(x));
famItems['volume-converter'].unshift('kg-to-liters-converter');
famItems['temperature-converter'] = extraSlugs.temp;
famItems['currency-converter'] = fxPairs.map(([a, b]) => fxSlug(a, b));
const famOrder = ['length-converter', 'weight-converter', 'currency-converter', 'temperature-converter', 'volume-converter', 'area-converter', 'speed-converter', 'time-converter', 'data-storage-converter', 'pressure-converter', 'energy-converter'];
const convGroups = famOrder.filter((x) => convLabel.has(x)).map((slug) => ({ slug, label: convLabel.get(slug)!, items: (famItems[slug] ?? []).filter((x) => x !== slug) }));
const calcGroups = (['money', 'health', 'time', 'daily', 'tools'] as Cat[]).map((c) => ({
  id: c, name: ar ? cats[c].ar : cats[c].en, icon: catIcon[c],
  items: Object.keys(meta).filter((sl) => meta[sl].cat === c && byS.has(sl)),
})).filter((g) => g.items.length);
const mainOf = ar ? 'الصفحة الرئيسية للتحويل' : 'Main converter';
const chev = '<svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
const allLabel = ar ? 'كل الأدوات' : 'All tools';
const convHead = ar ? 'التحويلات' : 'Converters';
const calcHead = ar ? 'الحاسبات' : 'Calculators';
---
<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <link rel="alternate" hreflang="en" href={href('en')} />
    <link rel="alternate" hreflang="ar" href={href('ar')} />
    <link rel="alternate" hreflang="x-default" href={href('en')} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Calcloom" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.add('js');try{var th=localStorage.getItem('theme');if(th==='light'||th==='dark')document.documentElement.dataset.theme=th;}catch(e){}</script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {/* Google Analytics 4 (property «Calcloom», stream 16312515903) */}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>
  <body>
    <div class="shell">
    <aside class="side" aria-label="Calcloom">
      <a class="brand" href={localePath(lang, '/')} aria-label="Calcloom">
        <svg class="logo" width="30" height="30" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#fbbf24"/><path d="M42 22a14 14 0 100 20" fill="none" stroke="#241800" stroke-width="7" stroke-linecap="round"/></svg>
        <b class="bn">Calc<span>loom</span></b>
      </a>
      <nav class="side-nav" aria-label="Categories">
        <a class="cat" href={localePath(lang, '/')}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>{allLabel}</a>
        <p class="side-h">{convHead}</p>
        {convGroups.map((g) => {
          const mine = localePath(lang, '/' + g.slug + '/');
          const open = here === mine || g.items.some((x) => here === localePath(lang, '/' + x + '/'));
          return (
            <details class="sg" open={open}>
              <summary><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={meta[g.slug].icon} /><span>{g.label}</span><Fragment set:html={chev} /></summary>
              <div class="sg-items">
                <a class={here === mine ? 'on' : ''} href={mine}>{mainOf}</a>
                {g.items.map((x) => <a class={here === localePath(lang, '/' + x + '/') ? 'on' : ''} href={localePath(lang, '/' + x + '/')}>{nm(x)}</a>)}
              </div>
            </details>
          );
        })}
        <a class={'cat' + (here === localePath(lang, '/fuel-economy-converter/') ? ' on' : '')} href={localePath(lang, '/fuel-economy-converter/')}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={meta['fuel-economy-converter'].icon} />{convLabel.get('fuel-economy-converter')}</a>
        <p class="side-h">{calcHead}</p>
        {calcGroups.map((g) => {
          const open = g.items.some((x) => here === localePath(lang, '/' + x + '/'));
          return (
            <details class="sg" open={open}>
              <summary><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon} /><span>{g.name}</span><Fragment set:html={chev} /></summary>
              <div class="sg-items">
                {g.items.map((x) => <a class={here === localePath(lang, '/' + x + '/') ? 'on' : ''} href={localePath(lang, '/' + x + '/')}>{nm(x)}</a>)}
              </div>
            </details>
          );
        })}
      </nav>
      <div class="side-foot">
        <a href={localePath(lang, '/about/')}>{t.about}</a>
        <a href={localePath(lang, '/privacy/')}>{t.privacy}</a>
        <a class="lang" href={localePath(other, enPath)} hreflang={other} lang={other}>{t.switchLabel}</a>
      </div>
    </aside>
    <div class="content">
    <header class="top">
      <div class="top-in">
        <a class="brand" href={localePath(lang, '/')} aria-label="Calcloom">
          <svg class="logo" width="30" height="30" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#fbbf24"/><path d="M42 22a14 14 0 100 20" fill="none" stroke="#241800" stroke-width="7" stroke-linecap="round"/></svg>
          <b class="bn">Calc<span>loom</span></b>
        </a>
        <nav>
          <a href={localePath(lang, '/')}>{t.allTools}</a>
          <a href={localePath(lang, '/about/')}>{t.about}</a>
        </nav>
        <div class="top-tools">
          <div class="langsw" role="group" aria-label="Language">
            <a href={localePath('en', enPath)} hreflang="en" lang="en" class={lang === 'en' ? 'on' : ''} aria-current={lang === 'en' ? 'true' : undefined}>English</a>
            <a href={localePath('ar', enPath)} hreflang="ar" lang="ar" class={lang === 'ar' ? 'on' : ''} aria-current={lang === 'ar' ? 'true' : undefined}>العربية</a>
          </div>
          <button type="button" class="themebtn top-theme" data-theme-toggle aria-label={themeLabel.toLight + ' / ' + themeLabel.toDark}><Fragment set:html={sunMoon} /><span class="t-to-light">{themeLabel.toLight}</span><span class="t-to-dark">{themeLabel.toDark}</span></button>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="foot-in">
        <div class="foot-tools">
          <strong>{t.allCalcs}</strong>
          <ul>
            {footTools.map((x) => <li><a href={localePath(lang, `/${x.slug}/`)}>{x.name}</a></li>)}
          </ul>
        </div>
        <p class="foot-note">{t.footer}</p>
        <p><a href={localePath(lang, '/about/')}>{t.about}</a> · <a href={localePath(lang, '/privacy/')}>{t.privacy}</a></p>
      </div>
    </footer>
    </div>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        function sync() { if (meta) meta.setAttribute('content', root.dataset.theme === 'light' ? '#f6f5f1' : '#111111'); }
        sync();
        document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
          b.addEventListener('click', function () {
            var next = root.dataset.theme === 'light' ? 'dark' : 'light';
            root.dataset.theme = next;
            try { localStorage.setItem('theme', next); } catch (e) {}
            sync();
          });
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.08 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #111111; --soft: #161616; --card: #1c1c1c; --ink: #f2f2f2; --muted: #b0b0b0;
    --line: #333333; --accent: #fbbf24; --accent-d: #f59e0b; --accent-ink: #241800;
    --tint: #2a2108; --shadow: 0 1px 2px rgba(0, 0, 0, .4); --shadow-lg: 0 10px 40px -12px rgba(0, 0, 0, .6);
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #f6f5f1; --soft: #ffffff; --card: #ffffff; --ink: #1c1917; --muted: #57534e;
    --line: #e3e0d8; --accent: #b45309; --accent-d: #92400e; --accent-ink: #ffffff;
    --tint: #fef3c7; --shadow: 0 1px 2px rgba(28, 25, 23, .08); --shadow-lg: 0 10px 40px -14px rgba(28, 25, 23, .18);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  html[lang="ar"] body { font-family: "Cairo", system-ui, "Segoe UI", sans-serif; font-size: 17px; }
  a { color: var(--accent); }
  ::selection { background: color-mix(in srgb, var(--accent) 25%, transparent); }
  .muted { color: var(--muted); font-size: .9rem; }

  /* shell with sidebar */
  .shell { display: grid; grid-template-columns: 250px minmax(0, 1fr); min-height: 100vh; }
  .content { min-width: 0; }
  .side { position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; padding: 22px 14px; background: var(--soft); border-inline-end: 1px solid var(--line); }
  .side .brand { margin: 0 6px 20px; }
  .side-nav { display: flex; flex-direction: column; gap: 2px; }
  .side-nav a.cat { display: flex; align-items: center; gap: 11px; padding: 9px 12px; border-radius: 9px; color: var(--muted); text-decoration: none; font-weight: 500; }
  .side-nav a.cat:hover, .side-nav a.cat.on { background: var(--card); color: var(--ink); }
  .side-nav a.cat.on svg, .side-nav a.cat:hover svg { color: var(--accent); }
  .side-nav details.sg { background: none; border: 0; border-radius: 0; padding: 0; margin: 0; }
  .side-nav details.sg > summary { display: flex; align-items: center; gap: 11px; padding: 9px 12px; margin: 0; border-radius: 9px; color: var(--muted); font-weight: 500; cursor: pointer; list-style: none; }
  .side-nav details.sg > summary::-webkit-details-marker { display: none; }
  .side-nav details.sg > summary:hover, .side-nav details.sg[open] > summary { background: var(--card); color: var(--ink); }
  .side-nav details.sg > summary:hover svg:first-child, .side-nav details.sg[open] > summary svg:first-child { color: var(--accent); }
  .side-nav details.sg .chev { margin-inline-start: auto; transition: transform .15s; opacity: .7; }
  .side-nav details.sg[open] .chev { transform: rotate(180deg); }
  .sg-items { display: flex; flex-direction: column; margin: 2px 0 6px; padding-inline-start: 20px; border-inline-start: 1px solid var(--line); margin-inline-start: 22px; }
  .sg-items a { padding: 6px 12px; border-radius: 7px; color: var(--muted); text-decoration: none; font-size: .88rem; line-height: 1.4; }
  .sg-items a:hover { color: var(--ink); background: var(--card); }
  .sg-items a.on { color: var(--accent); font-weight: 700; background: var(--card); }
  .side-h { margin: 14px 12px 4px; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); opacity: .7; }
  html[lang="ar"] .side-h { letter-spacing: 0; font-size: .8rem; }
  .side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 2px; padding-top: 16px; border-top: 1px solid var(--line); }
  .side-foot a { color: var(--muted); text-decoration: none; padding: 7px 12px; border-radius: 8px; font-size: .92rem; }
  .side-foot a:hover { color: var(--ink); background: var(--card); }
  .side-foot a.lang { color: var(--accent); font-weight: 700; }
  @media (max-width: 899px) { .shell { display: block; } .side { display: none; } }
  /* top bar: language + theme on every screen; brand and links only on mobile */
  .themebtn { display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 7px 13px; font-size: .9rem; font-weight: 600; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 999px; }
  .themebtn:hover { background: var(--card); border-color: var(--accent); color: var(--accent); }
  .themebtn .t-to-dark, .themebtn .i-moon { display: none; }
  :root[data-theme="light"] .themebtn .t-to-light, :root[data-theme="light"] .themebtn .i-sun { display: none; }
  :root[data-theme="light"] .themebtn .t-to-dark, :root[data-theme="light"] .themebtn .i-moon { display: inline; }
  .side-foot .themebtn { width: calc(100% - 8px); margin: 0 4px 8px; justify-content: flex-start; border-radius: 9px; }
  .top-tools { display: flex; align-items: center; gap: 8px; }
  .langsw { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; background: var(--card); }
  .langsw a { padding: 6px 14px; font-size: .9rem; font-weight: 600; color: var(--muted); text-decoration: none; }
  .langsw a:hover { color: var(--ink); }
  .langsw a.on { background: var(--accent); color: var(--accent-ink); }
  @media (min-width: 900px) {
    .top-in { max-width: none; justify-content: flex-end; padding: 10px 28px; }
    .top .top-in .brand, .top .top-in nav { display: none; }
  }
  @media (max-width: 899px) { .top-theme span { display: none !important; } .top-theme { padding: 7px 10px; } }
  @media (max-width: 520px) { .top nav a:not(.lang) { display: none; } }

  /* header */
  .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .top-in { display: flex; justify-content: space-between; align-items: center; max-width: 1080px; margin: 0 auto; padding: 12px 18px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; font-size: 1.3rem; text-decoration: none; color: var(--ink); letter-spacing: -.3px; }
  .brand span { color: var(--accent); }
  .bn { font-weight: inherit; }
  .top nav { display: flex; align-items: center; gap: 2px; }
  .top nav a { text-decoration: none; color: var(--muted); padding: 7px 13px; border-radius: 8px; font-weight: 500; font-size: .95rem; }
  .top nav a:hover { color: var(--ink); background: var(--soft); }
  .top nav a.lang { color: var(--accent); font-weight: 700; }

  main { max-width: 1080px; margin: 0 auto; padding: 0 18px 56px; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); line-height: 1.15; margin: 8px 0 12px; font-weight: 800; letter-spacing: -.8px; }
  h2 { margin: 2.4rem 0 .9rem; font-size: 1.45rem; font-weight: 800; letter-spacing: -.3px; }
  html[lang="ar"] h1, html[lang="ar"] h2 { letter-spacing: 0; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 62ch; }

  /* hero */
  .hero { margin: 0 -18px; padding: 52px 18px 44px; background: linear-gradient(var(--soft), var(--bg)); border-bottom: 1px solid var(--line); }
  .hero-grid { max-width: 1080px; margin: 0 auto; display: grid; gap: 36px; align-items: center; }
  @media (min-width: 860px) { .hero-grid { grid-template-columns: 1.1fr .9fr; } }
