---
import '@fontsource/cairo/latin-400.css';
import '@fontsource/cairo/latin-600.css';
import '@fontsource/cairo/latin-800.css';
import '@fontsource/cairo/arabic-400.css';
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-800.css';
import { ui, localePath, BASE, type Lang } from '../i18n';
import { allTools } from '../data/get';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  schema?: object[];
  noindex?: boolean;
}
const { title, description, lang = "en", schema = [], noindex = false } = Astro.props;
const t = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// English path of the current page, used to build both language URLs
const enPath = Astro.url.pathname.slice(BASE.length).replace(/^\/ar(?=\/|$)/, '') || '/';
const href = (l: Lang) => new URL(localePath(l, enPath), Astro.site).href;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const ogImage = new URL(`${BASE}/og.png`, Astro.site).href;
const footTools = allTools(lang).filter((x) => x.kind !== 'pair');
---
<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <link rel="alternate" hreflang="en" href={href('en')} />
    <link rel="alternate" hreflang="ar" href={href('ar')} />
    <link rel="alternate" hreflang="x-default" href={href('en')} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <meta name="theme-color" content="#2563eb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Calcloom" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class="top">
      <div class="top-in">
        <a class="brand" href={localePath(lang, '/')} aria-label="Calcloom">
          <svg class="logo" width="30" height="30" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#2563eb"/><path d="M42 22a14 14 0 100 20" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round"/></svg>
          Calc<span>loom</span>
        </a>
        <nav>
          <a href={localePath(lang, '/')}>{t.allTools}</a>
          <a href={localePath(lang, '/about/')}>{t.about}</a>
          <a class="lang" href={localePath(other, enPath)} hreflang={other} lang={other}>{ui[other].switchLabel}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="foot-in">
        <div class="foot-tools">
          <strong>{t.allCalcs}</strong>
          <ul>
            {footTools.map((x) => <li><a href={localePath(lang, `/${x.slug}/`)}>{x.name}</a></li>)}
          </ul>
        </div>
        <p class="foot-note">{t.footer}</p>
        <p><a href={localePath(lang, '/about/')}>{t.about}</a> · <a href={localePath(lang, '/privacy/')}>{t.privacy}</a></p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.08 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --soft: #f8fafc; --card: #ffffff; --ink: #0f172a; --muted: #475569;
    --line: #e2e8f0; --accent: #2563eb; --accent-d: #1d4ed8; --accent-ink: #fff;
    --tint: #eff6ff; --shadow: 0 1px 2px rgba(15, 23, 42, .05), 0 8px 24px -12px rgba(15, 23, 42, .12);
    --shadow-lg: 0 10px 40px -12px rgba(15, 23, 42, .18);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b1220; --soft: #0f1829; --card: #121c31; --ink: #e5eaf5; --muted: #94a3b8;
      --line: #24324d; --accent: #60a5fa; --accent-d: #93c5fd; --accent-ink: #0b1220; --tint: #15233f;
      --shadow: 0 1px 2px rgba(0, 0, 0, .4); --shadow-lg: 0 10px 40px -12px rgba(0, 0, 0, .6);
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  html[lang="ar"] body { font-family: "Cairo", system-ui, "Segoe UI", sans-serif; font-size: 17px; }
  a { color: var(--accent); }
  ::selection { background: color-mix(in srgb, var(--accent) 25%, transparent); }
  .muted { color: var(--muted); font-size: .9rem; }

  /* header */
  .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .top-in { display: flex; justify-content: space-between; align-items: center; max-width: 1080px; margin: 0 auto; padding: 12px 18px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; font-size: 1.3rem; text-decoration: none; color: var(--ink); letter-spacing: -.3px; }
  .brand span { color: var(--accent); }
  .top nav { display: flex; align-items: center; gap: 2px; }
  .top nav a { text-decoration: none; color: var(--muted); padding: 7px 13px; border-radius: 8px; font-weight: 500; font-size: .95rem; }
  .top nav a:hover { color: var(--ink); background: var(--soft); }
  .top nav a.lang { color: var(--accent); font-weight: 700; }

  main { max-width: 1080px; margin: 0 auto; padding: 0 18px 56px; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); line-height: 1.15; margin: 8px 0 12px; font-weight: 800; letter-spacing: -.8px; }
  h2 { margin: 2.4rem 0 .9rem; font-size: 1.45rem; font-weight: 800; letter-spacing: -.3px; }
  html[lang="ar"] h1, html[lang="ar"] h2 { letter-spacing: 0; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 62ch; }

  /* hero */
  .hero { margin: 0 -18px; padding: 52px 18px 44px; background: linear-gradient(var(--soft), var(--bg)); border-bottom: 1px solid var(--line); }
  .hero-grid { max-width: 1080px; margin: 0 auto; display: grid; gap: 36px; align-items: center; }
  @media (min-width: 860px) { .hero-grid { grid-template-columns: 1.1fr .9fr; } }
  .hero h1 { font-size: clamp(2.1rem, 5.5vw, 3rem); line-height: 1.1; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .badge { display: inline-flex; gap: 8px; align-items: center; padding: 4px 12px; border-radius: 999px; font-size: .82rem; font-weight: 600; color: var(--accent); background: var(--tint); border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent); }
  .badge i { width: 7px; height: 7px; border-radius: 50%; background: #16a34a; }
  .search { position: relative; margin-top: 22px; max-width: 480px; }
  .search { max-width: 560px; }
  .search input { padding: 18px 18px; font-size: 1.1rem; border-width: 2px; padding-inline-start: 46px; border-radius: 10px; font-size: 1rem; box-shadow: var(--shadow); }
  .search svg { position: absolute; inset-inline-start: 15px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  .trust { display: flex; gap: 18px; margin-top: 20px; flex-wrap: wrap; color: var(--muted); font-size: .9rem; }
  .trust span::before { content: "✓"; color: #16a34a; font-weight: 800; margin-inline-end: 6px; }
  .widget { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 22px; box-shadow: var(--shadow-lg); }
  .widget h2 { margin: 0 0 12px; font-size: 1.05rem; }
  .widget .wrow { display: flex; align-items: flex-end; gap: 10px; }
  .widget .wrow > div { flex: 1; min-width: 0; }
  .widget output { display: block; padding: 12px 14px; font-size: 1.15rem; font-weight: 700; border: 1.5px solid var(--line); border-radius: 10px; background: var(--tint); min-height: 50px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .widget .eq { padding-bottom: 12px; color: var(--muted); font-size: 1.3rem; }
  .widget a.more { display: inline-block; margin-top: 12px; font-size: .9rem; font-weight: 600; text-decoration: none; }

  /* chips */
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
  .chip { cursor: pointer; border: 1px solid var(--line); background: var(--card); color: var(--ink); padding: 6px 15px; border-radius: 8px; font: inherit; font-weight: 600; font-size: .9rem; margin: 0; }
  .chip:hover { border-color: var(--accent); background: var(--card); }
  .chip[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }

  /* tiles */
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .grid a.tile { display: flex; gap: 14px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px; text-decoration: none; color: var(--ink); transition: border-color .15s, box-shadow .15s, transform .15s; }
  .grid a.tile:hover { border-color: var(--accent); box-shadow: 0 6px 20px -8px color-mix(in srgb, var(--accent) 35%, transparent); transform: translateY(-2px); }
  .tile .tx { min-width: 0; }
  .tile strong { display: block; font-weight: 700; line-height: 1.35; margin-bottom: 2px; }
  .tile span.d { color: var(--muted); font-size: .88rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ico { flex: none; display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; color: var(--accent); background: var(--tint); }
  .quick { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .quick a { text-decoration: none; color: var(--accent); background: var(--tint); border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--line)); padding: 6px 14px; border-radius: 999px; font-size: .88rem; font-weight: 600; }
  .quick a:hover { background: var(--accent); color: var(--accent-ink); }
  .cv-quick { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
  .cv-quick button { margin: 0; padding: 6px 14px; font-size: .9rem; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 999px; }
  .cv-quick button:hover { border-color: var(--accent); color: var(--accent); }
  .cv-quick .copy { margin-inline-start: auto; background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .cv-quick .copy:hover { color: var(--accent-ink); opacity: .9; }
  #cv-v { font-size: 1.6rem; font-weight: 700; padding: 12px 14px; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pills a { text-decoration: none; color: var(--ink); border: 1px solid var(--line); background: var(--card); padding: 6px 14px; border-radius: 8px; font-size: .9rem; font-weight: 500; }
  .pills a:hover { border-color: var(--accent); color: var(--accent); }
  .hidden { display: none !important; }
  .empty { color: var(--muted); padding: 20px 0; }

  /* tool page */
  .crumbs { font-size: .88rem; color: var(--muted); margin-top: 18px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .tool-head { display: flex; gap: 14px; align-items: center; margin-top: 10px; }
  .tool-head .ico { width: 54px; height: 54px; border-radius: 14px; }
  .tool-head h1 { margin: 0; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 24px; margin: 22px 0; box-shadow: var(--shadow-lg); }
  label { display: block; font-weight: 600; margin: 12px 0 5px; font-size: .9rem; }
  input, select, textarea { width: 100%; padding: 12px 14px; font: inherit; color: var(--ink); background: var(--bg); border: 1.5px solid var(--line); border-radius: 10px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent); }
  .row { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .cv-grid { display: grid; gap: 12px; align-items: end; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .cv-grid { grid-template-columns: 1fr 1.3fr auto 1.3fr; } }
  button { margin-top: 16px; margin-inline-end: 8px; padding: 12px 24px; font: inherit; font-weight: 700; border: 0; border-radius: 10px; background: var(--accent); color: var(--accent-ink); cursor: pointer; transition: background .15s, transform .1s; }
  button:hover { background: var(--accent-d); }
  button:active { transform: translateY(1px); }
  button.swap { margin: 0; padding: 12px 16px; font-size: 1.2rem; line-height: 1.2; background: var(--tint); color: var(--accent); border: 1.5px solid var(--line); }
  button.swap:hover { background: var(--accent); color: var(--accent-ink); }
  .result { margin-top: 20px; padding: 18px 20px; border-radius: 12px; background: var(--tint); border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line)); min-height: 3.5rem; }
  .result > * { animation: pop .25s ease both; }
  .result .big { font-size: clamp(1.7rem, 5vw, 2.3rem); font-weight: 800; line-height: 1.25; color: var(--accent); overflow-wrap: anywhere; }
  .result p { margin: 4px 0; }
  .conv-table { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .conv-table th, .conv-table td { padding: 10px 16px; text-align: start; border-bottom: 1px solid var(--line); }
  .conv-table th { background: var(--tint); font-weight: 700; }
  .conv-table tr:last-child td { border-bottom: 0; }
  .conv-table tbody tr:hover { background: var(--soft); }
  details { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 2px 18px; margin-bottom: 10px; }
  details[open] { border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
  summary { font-weight: 700; cursor: pointer; padding: 12px 0; }
  ol li { margin: 6px 0; }

  /* footer */
  footer { border-top: 1px solid var(--line); background: var(--soft); }
  .foot-in { max-width: 1080px; margin: 0 auto; padding: 28px 18px 40px; color: var(--muted); font-size: .9rem; }
  .foot-tools ul { list-style: none; padding: 0; margin: 8px 0 18px; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .foot-tools a, .foot-in a { color: var(--muted); text-decoration: none; }
  .foot-tools a:hover, .foot-in a:hover { color: var(--accent); }
  .foot-tools strong { color: var(--ink); }

  /* motion (kept light) */
  .js .reveal { opacity: 0; transform: translateY(12px); transition: opacity .45s ease, transform .45s ease; transition-delay: var(--d, 0s); }
  .js .reveal.in { opacity: 1; transform: none; }
  @keyframes pop { from { opacity: 0; transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .js .reveal { opacity: 1; transform: none; }
    html { scroll-behavior: auto; }
  }
</style>
