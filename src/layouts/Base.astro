---
import '@fontsource/cairo/latin-400.css';
import '@fontsource/cairo/latin-600.css';
import '@fontsource/cairo/latin-800.css';
import '@fontsource/cairo/arabic-400.css';
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-800.css';
import { ui, localePath, BASE, type Lang } from '../i18n';
import { allTools } from '../data/get';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  schema?: object[];
}
const { title, description, lang = 'en', schema = [] } = Astro.props;
const t = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// English path of the current page, used to build both language URLs
const enPath = Astro.url.pathname.slice(BASE.length).replace(/^\/ar(?=\/|$)/, '') || '/';
const href = (l: Lang) => new URL(localePath(l, enPath), Astro.site).href;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const footTools = allTools(lang);
---
<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <link rel="alternate" hreflang="en" href={href('en')} />
    <link rel="alternate" hreflang="ar" href={href('ar')} />
    <link rel="alternate" hreflang="x-default" href={href('en')} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <meta name="theme-color" content="#4f46e5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class="top">
      <div class="top-in">
        <a class="brand" href={localePath(lang, '/')} aria-label="Calcloom">
          <svg class="logo" width="30" height="30" viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6366f1"/><stop offset="1" stop-color="#06b6d4"/></linearGradient></defs><rect width="64" height="64" rx="16" fill="url(#lg)"/><path d="M42 22a14 14 0 100 20" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round"/></svg>
          Calc<span>loom</span>
        </a>
        <nav>
          <a href={localePath(lang, '/')}>{t.allTools}</a>
          <a href={localePath(lang, '/about/')}>{t.about}</a>
          <a class="lang" href={localePath(other, enPath)} hreflang={other} lang={other}>{ui[other].switchLabel}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="foot-in">
        <div class="foot-tools">
          <strong>{t.allCalcs}</strong>
          <ul>
            {footTools.map((x) => <li><a href={localePath(lang, `/${x.slug}/`)}>{x.name}</a></li>)}
          </ul>
        </div>
        <p class="foot-note">{t.footer}</p>
        <p><a href={localePath(lang, '/about/')}>{t.about}</a> · <a href={localePath(lang, '/privacy/')}>{t.privacy}</a></p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.08 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f7fb; --card: #ffffff; --ink: #14172b; --muted: #5b6178;
    --line: #e3e6f0; --accent: #4f46e5; --accent2: #06b6d4; --accent-ink: #fff;
    --grad: linear-gradient(135deg, #6366f1, #06b6d4);
    --shadow: 0 1px 2px rgba(20, 23, 43, .05), 0 8px 24px -8px rgba(79, 70, 229, .18);
    --shadow-lg: 0 2px 4px rgba(20, 23, 43, .06), 0 24px 48px -16px rgba(79, 70, 229, .3);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b1020; --card: #131a30; --ink: #eef0fb; --muted: #9aa3c0;
      --line: #25304f; --accent: #818cf8; --accent2: #22d3ee; --accent-ink: #0b1020;
      --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px -8px rgba(0, 0, 0, .5);
      --shadow-lg: 0 2px 4px rgba(0, 0, 0, .5), 0 24px 48px -16px rgba(99, 102, 241, .35);
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.7 "Cairo", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: var(--accent); }
  ::selection { background: color-mix(in srgb, var(--accent) 30%, transparent); }

  /* header */
  .top { position: sticky; top: 0; z-index: 20; backdrop-filter: saturate(1.4) blur(14px); background: color-mix(in srgb, var(--bg) 78%, transparent); border-bottom: 1px solid var(--line); }
  .top-in { display: flex; justify-content: space-between; align-items: center; max-width: 1040px; margin: 0 auto; padding: 10px 16px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.45rem; text-decoration: none; color: var(--ink); letter-spacing: -.3px; }
  .brand span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .brand .logo { transition: transform .4s cubic-bezier(.3, 1.6, .5, 1); }
  .brand:hover .logo { transform: rotate(-12deg) scale(1.1); }
  .top nav { display: flex; align-items: center; gap: 4px; }
  .top nav a { text-decoration: none; color: var(--muted); padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: .95rem; transition: background .2s, color .2s; }
  .top nav a:hover { color: var(--ink); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .top nav a.lang { color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); }

  main { max-width: 1040px; margin: 0 auto; padding: 0 16px 56px; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.7rem); line-height: 1.2; margin: 8px 0 12px; font-weight: 800; letter-spacing: -.5px; }
  h2 { margin: 2.4rem 0 .8rem; font-size: 1.5rem; font-weight: 800; }
  .lead { color: var(--muted); font-size: 1.12rem; max-width: 60ch; }

  /* hero */
  .hero { position: relative; margin: 20px 0 8px; padding: clamp(28px, 6vw, 56px) clamp(18px, 4vw, 44px); border-radius: 28px; overflow: hidden; background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow); isolation: isolate; }
  .hero::before, .hero::after { content: ""; position: absolute; width: 380px; height: 380px; border-radius: 50%; filter: blur(70px); opacity: .45; z-index: -1; animation: drift 14s ease-in-out infinite alternate; }
  .hero::before { background: #6366f1; top: -140px; inset-inline-start: -90px; }
  .hero::after { background: #06b6d4; bottom: -160px; inset-inline-end: -80px; animation-delay: -6s; }
  .hero-grid { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 820px) { .hero-grid { grid-template-columns: 1.15fr .85fr; } }
  .badge { display: inline-flex; gap: 8px; align-items: center; padding: 5px 14px; border-radius: 999px; font-size: .85rem; font-weight: 600; color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); }
  .badge i { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34, 197, 94, .6); animation: pulse 2s infinite; }
  .grad-text { background: linear-gradient(120deg, var(--accent), var(--accent2), var(--accent)); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shine 6s linear infinite; }
  .search { position: relative; margin-top: 20px; max-width: 460px; }
  .search input { padding: 14px 16px; padding-inline-start: 46px; border-radius: 16px; font-size: 1rem; box-shadow: var(--shadow); }
  .search svg { position: absolute; inset-inline-start: 15px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .stats { display: flex; gap: 22px; margin-top: 22px; flex-wrap: wrap; }
  .stats div { display: flex; flex-direction: column; line-height: 1.2; }
  .stats b { font-size: 1.6rem; font-weight: 800; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stats span { font-size: .85rem; color: var(--muted); }

  /* floating demo cards */
  .float-stack { position: relative; min-height: 270px; display: none; }
  @media (min-width: 820px) { .float-stack { display: block; } }
  .fc { position: absolute; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 12px 16px; box-shadow: var(--shadow-lg); display: flex; gap: 12px; align-items: center; animation: bob 6s ease-in-out infinite; white-space: nowrap; }
  .fc small { display: block; color: var(--muted); font-size: .78rem; line-height: 1.2; }
  .fc b { font-size: 1.25rem; font-weight: 800; line-height: 1.3; }
  .fc .ico { width: 40px; height: 40px; }
  .fc1 { top: 0; inset-inline-start: 6%; }
  .fc2 { top: 78px; inset-inline-end: 0; animation-delay: -2s; }
  .fc3 { top: 160px; inset-inline-start: 0; animation-delay: -4s; }
  .fc4 { top: 224px; inset-inline-end: 8%; animation-delay: -1s; }

  /* category chips */
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 26px 0 14px; }
  .chip { cursor: pointer; border: 1px solid var(--line); background: var(--card); color: var(--ink); padding: 7px 16px; border-radius: 999px; font: inherit; font-weight: 600; font-size: .92rem; margin: 0; transition: all .2s; }
  .chip:hover { border-color: var(--accent); }
  .chip[aria-pressed="true"] { background: var(--grad); color: #fff; border-color: transparent; }

  /* tiles + icons */
  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); }
  .grid a.tile { position: relative; display: flex; gap: 14px; background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 18px; text-decoration: none; color: var(--ink); transition: transform .25s, box-shadow .25s, border-color .25s; box-shadow: var(--shadow); }
  .grid a.tile::after { content: "→"; position: absolute; inset-inline-end: 16px; top: 16px; color: var(--accent); opacity: 0; transform: translateX(-6px); transition: all .25s; }
  [dir="rtl"] .grid a.tile::after { content: "←"; transform: translateX(6px); }
  .grid a.tile:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: hsl(var(--h, 240) 70% 60% / .6); }
  .grid a.tile:hover::after { opacity: 1; transform: none; }
  .tile .tx { min-width: 0; }
  .tile strong { display: block; font-weight: 800; margin-bottom: 2px; line-height: 1.35; }
  .tile span.d { color: var(--muted); font-size: .9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ico { flex: none; display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; color: hsl(var(--h) 62% 36%); background: linear-gradient(135deg, hsl(var(--h) 90% 94%), hsl(var(--h) 80% 86%)); transition: transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  @media (prefers-color-scheme: dark) { .ico { color: hsl(var(--h) 90% 75%); background: linear-gradient(135deg, hsl(var(--h) 50% 22%), hsl(var(--h) 55% 16%)); } }
  .tile:hover .ico { transform: scale(1.12) rotate(-6deg); }
  .hidden { display: none !important; }
  .empty { color: var(--muted); padding: 20px 0; }

  /* tool page */
  .tool-head { display: flex; gap: 16px; align-items: center; margin-top: 22px; }
  .tool-head .ico { width: 60px; height: 60px; border-radius: 18px; }
  .tool-head h1 { margin: 0; }
  .crumbs { font-size: .88rem; color: var(--muted); margin-top: 18px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .card { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 24px; padding: 24px; margin: 22px 0; box-shadow: var(--shadow-lg); overflow: hidden; }
  .card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--grad); }
  label { display: block; font-weight: 600; margin: 12px 0 5px; font-size: .93rem; }
  input, select, textarea { width: 100%; padding: 12px 14px; font: inherit; color: var(--ink); background: var(--bg); border: 1.5px solid var(--line); border-radius: 12px; transition: border-color .2s, box-shadow .2s; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); }
  .row { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  button { margin-top: 16px; margin-inline-end: 8px; padding: 12px 26px; font: inherit; font-weight: 700; border: 0; border-radius: 12px; background: var(--grad); color: #fff; cursor: pointer; box-shadow: 0 8px 20px -8px rgba(79, 70, 229, .6); transition: transform .15s, box-shadow .15s, filter .15s; }
  button:hover { transform: translateY(-2px); filter: brightness(1.06); box-shadow: 0 12px 24px -8px rgba(79, 70, 229, .7); }
  button:active { transform: translateY(0); }
  .result { margin-top: 20px; padding: 18px 20px; border-radius: 16px; background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 8%, var(--bg)), color-mix(in srgb, var(--accent2) 8%, var(--bg))); border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--line)); min-height: 3.5rem; }
  .result > * { animation: pop .35s ease both; }
  .result .big { font-size: clamp(1.7rem, 5vw, 2.2rem); font-weight: 800; line-height: 1.25; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .result p { margin: 4px 0; }
  details { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 4px 18px; margin-bottom: 10px; transition: border-color .2s; }
  details[open] { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  summary { font-weight: 700; cursor: pointer; padding: 12px 0; }
  ol li { margin: 6px 0; }

  /* footer */
  footer { border-top: 1px solid var(--line); background: var(--card); }
  .foot-in { max-width: 1040px; margin: 0 auto; padding: 28px 16px 40px; color: var(--muted); font-size: .92rem; }
  .foot-tools ul { list-style: none; padding: 0; margin: 8px 0 18px; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .foot-tools a, .foot-in a { color: var(--muted); text-decoration: none; }
  .foot-tools a:hover, .foot-in a:hover { color: var(--accent); }
  .foot-tools strong { color: var(--ink); }

  /* motion */
  .js .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; transition-delay: var(--d, 0s); }
  .js .reveal.in { opacity: 1; transform: none; }
  @keyframes drift { to { transform: translate(60px, 40px) scale(1.15); } }
  @keyframes bob { 50% { transform: translateY(-12px); } }
  @keyframes shine { to { background-position: 200% center; } }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(34, 197, 94, 0); } 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); } }
  @keyframes pop { from { opacity: 0; transform: translateY(6px) scale(.98); } }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .js .reveal { opacity: 1; transform: none; }
    html { scroll-behavior: auto; }
  }
</style>
