---
import Base from '../layouts/Base.astro';
import { getTool } from '../data/get';
import { ui, localePath, type Lang } from '../i18n';
import Percentage from './tools/Percentage.astro';
import Loan from './tools/Loan.astro';
import Compound from './tools/Compound.astro';
import Age from './tools/Age.astro';
import Bmi from './tools/Bmi.astro';
import Tip from './tools/Tip.astro';
import Discount from './tools/Discount.astro';
import DaysBetween from './tools/DaysBetween.astro';
import Hourly from './tools/Hourly.astro';
import Words from './tools/Words.astro';
import Icon from './Icon.astro';
import { meta, cats } from '../data/meta';
import Temperature from './tools/Temperature.astro';
import Password from './tools/Password.astro';
import Savings from './tools/Savings.astro';
import Convert from './tools/Convert.astro';
import Density from './tools/Density.astro';
import FuelEconomy from './tools/FuelEconomy.astro';
import Fuel from './tools/Fuel.astro';

interface Props { slug: string; lang: Lang }
const { slug, lang } = Astro.props;

const components: Record<string, any> = {
  'percentage-calculator': Percentage,
  'loan-calculator': Loan,
  'compound-interest-calculator': Compound,
  'age-calculator': Age,
  'bmi-calculator': Bmi,
  'tip-calculator': Tip,
  'discount-calculator': Discount,
  'days-between-dates-calculator': DaysBetween,
  'hourly-to-salary-calculator': Hourly,
  'word-counter': Words,
  'temperature-converter': Temperature,
  'password-generator': Password,
  'savings-goal-calculator': Savings,
  'kg-to-liters-converter': Density,
  'fuel-economy-converter': FuelEconomy,
  'fuel-cost-calculator': Fuel,
};

const t = ui[lang];
const tool = getTool(slug, lang);
const Tool = components[slug];
const url = new URL(localePath(lang, `/${slug}/`), Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url,
    inLanguage: lang,
    description: tool.description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: tool.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(localePath(lang, '/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: tool.name, item: url },
    ],
  },
];
---
<Base title={tool.title} description={tool.description} {lang} {schema}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={localePath(lang, '/')}>{t.home}</a> › <span>{tool.name}</span>
  </nav>
  <div class="tool-head">
    <Icon slug={slug} size={30} />
    <h1>{tool.h1}</h1>
  </div>
  <p class="lead">{tool.intro}</p>

  <section class="card" aria-label={tool.name}>
    {tool.conv ? <Convert {lang} conv={tool.conv} /> : <Tool {lang} />}
  </section>

  {tool.about && (
    <>
      <h2 class="reveal">{tool.about.title}</h2>
      {tool.about.paras.map((p) => <p class="reveal" dir="auto">{p}</p>)}
    </>
  )}

  {tool.table && (
    <>
      <h2 class="reveal">{tool.tableTitle}</h2>
      <table class="conv-table reveal">
        <thead><tr>{tool.table.head.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{tool.table.rows.map((r) => <tr>{r.map((c) => <td dir="ltr">{c}</td>)}</tr>)}</tbody>
      </table>
    </>
  )}

  <h2 class="reveal">{t.howTo(tool.name)}</h2>
  <ol class="reveal">{tool.steps.map((s) => <li>{s}</li>)}</ol>

  <h2 class="reveal">{t.faq}</h2>
  {tool.faq.map((f) => (
    <details class="reveal">
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}

  <h2 class="reveal">{t.more}</h2>
  <div class="grid">
    {tool.related.map((r, i) => {
      const rt = getTool(r, lang);
      return (
        <a class="tile reveal" style={`--h:${cats[meta[r].cat].hue};--d:${i * 0.07}s`} href={localePath(lang, `/${rt.slug}/`)}>
          <Icon slug={r} />
          <div class="tx">
            <strong>{rt.name}</strong>
            <span class="d">{rt.intro}</span>
          </div>
        </a>
      );
    })}
  </div>
</Base>
