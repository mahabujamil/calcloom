---
const { lang } = Astro.props;
const S = lang === 'fr'
  ? { price: "Prix d'origine", disc: "Remise (%)", extra: "Remise supplémentaire (%) facultative", calc: "Calculer",
      err: "Saisissez un prix et des remises entre 0 et 100.", save: "Vous économisez : <strong>{0}</strong>", totald: "Remise totale : <strong>{0} %</strong>" }
  : lang === 'es'
  ? { price: "Precio original", disc: "Descuento (%)", extra: "Descuento adicional (%) opcional", calc: "Calcular",
      err: "Introduce un precio y descuentos entre 0 y 100.", save: "Ahorras: <strong>{0}</strong>", totald: "Descuento total: <strong>{0}%</strong>" }
  : lang === 'ar'
  ? { price: 'السعر الأصلي', disc: 'الخصم (%)', extra: 'خصم إضافي (%) اختياري', calc: 'احسب',
      err: 'أدخل سعراً وخصومات بين 0 و100.', save: 'توفّر: <strong>{0}</strong>', totald: 'إجمالي الخصم: <strong>{0}%</strong>' }
  : { price: 'Original price', disc: 'Discount (%)', extra: 'Extra discount (%) optional', calc: 'Calculate',
      err: 'Enter a price and discounts between 0 and 100.', save: 'You save: <strong>{0}</strong>', totald: 'Total discount: <strong>{0}%</strong>' };
---
<form id="dc" onsubmit="return false" data-s={JSON.stringify(S)}>
  <div class="row">
    <div><label for="dc-p">{S.price}</label><input id="dc-p" type="number" min="0" step="any" value="120" /></div>
    <div><label for="dc-d">{S.disc}</label><input id="dc-d" type="number" min="0" max="100" step="any" value="25" /></div>
    <div><label for="dc-e">{S.extra}</label><input id="dc-e" type="number" min="0" max="100" step="any" value="0" /></div>
  </div>
  <button id="dc-go" type="button">{S.calc}</button>
  <div class="result" id="dc-out" aria-live="polite"></div>
</form>

<script>
  import { $, money, fill, strings } from '../../lib/util';
  const S = strings('dc');
  function run() {
    const p = parseFloat($('dc-p').value), d = parseFloat($('dc-d').value), e = parseFloat($('dc-e').value || '0');
    const out = $('dc-out');
    if ([p, d, e].some(isNaN) || p < 0 || d < 0 || d > 100 || e < 0 || e > 100) { out.textContent = S.err; return; }
    const final = p * (1 - d / 100) * (1 - e / 100);
    out.innerHTML = `<p class="big">${money(final)}</p><p>${fill(S.save, money(p - final))}</p><p>${fill(S.totald, ((1 - final / p) * 100 || 0).toFixed(2))}</p>`;
  }
  $('dc-go').addEventListener('click', run);
  ['dc-p', 'dc-d', 'dc-e'].forEach((id) => $(id).addEventListener('input', run));
  run();
</script>
