---
import { tr, locale } from '../../lib/t';
const { lang } = Astro.props;
// density in kg per litre
const subs: [string, string, number][] = [
  [tr(lang, 'Water', 'ماء', 'Eau', 'Agua'), 'water', 1],
  [tr(lang, 'Milk', 'حليب', 'Lait', 'Leche'), 'milk', 1.03],
  [tr(lang, 'Olive oil', 'زيت زيتون', "Huile d'olive", 'Aceite de oliva'), 'olive', 0.91],
  [tr(lang, 'Vegetable oil', 'زيت نباتي', 'Huile végétale', 'Aceite vegetal'), 'veg', 0.92],
  [tr(lang, 'Petrol / gasoline', 'بنزين', 'Essence', 'Gasolina'), 'petrol', 0.745],
  [tr(lang, 'Diesel', 'ديزل', 'Gazole', 'Diésel'), 'diesel', 0.832],
  [tr(lang, 'Honey', 'عسل', 'Miel', 'Miel'), 'honey', 1.42],
  [tr(lang, 'Juice', 'عصير', 'Jus', 'Zumo'), 'juice', 1.05],
  [tr(lang, 'Ethanol', 'كحول إيثيلي', 'Éthanol', 'Etanol'), 'ethanol', 0.789],
  [tr(lang, 'Flour (approx.)', 'طحين (تقريبي)', 'Farine (approx.)', 'Harina (aprox.)'), 'flour', 0.53],
  [tr(lang, 'Sugar (approx.)', 'سكر (تقريبي)', 'Sucre (approx.)', 'Azúcar (aprox.)'), 'sugar', 0.85],
  [tr(lang, 'Rice (approx.)', 'أرز (تقريبي)', 'Riz (approx.)', 'Arroz (aprox.)'), 'rice', 0.85],
  [tr(lang, 'Salt (approx.)', 'ملح (تقريبي)', 'Sel (approx.)', 'Sal (aprox.)'), 'salt', 1.2],
];
const S = {
  sub: tr(lang, 'Substance', 'المادة', 'Substance', 'Sustancia'),
  dir: tr(lang, 'Direction', 'الاتجاه', 'Sens', 'Dirección'),
  k2l: tr(lang, 'Kilograms to litres', 'كيلوغرام إلى لتر', 'Kilogrammes en litres', 'Kilogramos a litros'),
  l2k: tr(lang, 'Litres to kilograms', 'لتر إلى كيلوغرام', 'Litres en kilogrammes', 'Litros a kilogramos'),
  val: tr(lang, 'Value', 'القيمة', 'Valeur', 'Valor'),
  err: tr(lang, 'Enter a positive number.', 'أدخل رقماً موجباً.', 'Saisissez un nombre positif.', 'Introduce un número positivo.'),
  dens: tr(lang, 'Density: {0} kg/L', 'الكثافة: {0} كغ/لتر', 'Densité : {0} kg/L', 'Densidad: {0} kg/L'),
  note: tr(lang, 'Values are approximate and vary with temperature and type.', 'القيم تقريبية وتتغير بدرجة الحرارة والنوع.', 'Valeurs approximatives, variables selon la température et le type.', 'Los valores son aproximados y varían con la temperatura y el tipo.'),
  subs,
};
---
<form id="dn" onsubmit="return false" data-s={JSON.stringify(S)}>
  <div class="row">
    <div><label for="dn-s">{S.sub}</label><select id="dn-s">{subs.map((x) => <option value={x[1]}>{x[0]}</option>)}</select></div>
    <div><label for="dn-d">{S.dir}</label><select id="dn-d"><option value="k">{S.k2l}</option><option value="l">{S.l2k}</option></select></div>
    <div><label for="dn-v">{S.val}</label><input id="dn-v" type="number" min="0" step="any" value="1" inputmode="decimal" /></div>
  </div>
  <div class="result" id="dn-out" aria-live="polite"></div>
</form>

<script>
  import { $, fill, strings , LOC, dec } from '../../lib/util';
  const S = strings('dn');
  const subs = S.subs as [string, string, number][];
  const fmt = (n: number) => Number(n.toPrecision(6)).toLocaleString(LOC(), { maximumFractionDigits: 8 });
  function run() {
    const out = $('dn-out');
    const v = parseFloat($('dn-v').value);
    if (isNaN(v) || v < 0) { out.textContent = S.err; return; }
    const d = subs.find((x) => x[1] === $('dn-s').value)![2];
    const kgToL = $('dn-d').value === 'k';
    const res = kgToL ? v / d : v * d;
    out.innerHTML = `<p class="big" dir="ltr">${fmt(res)} ${kgToL ? 'L' : 'kg'}</p><p dir="ltr">${fmt(v)} ${kgToL ? 'kg' : 'L'} → ${fmt(res)} ${kgToL ? 'L' : 'kg'}</p><p>${fill(S.dens, d)}</p><p class="muted">${S.note}</p>`;
  }
  ['dn-s', 'dn-d'].forEach((id) => $(id).addEventListener('change', run));
  $('dn-v').addEventListener('input', run);
  run();
</script>
