---
const { lang } = Astro.props;
const S = lang === 'fr'
  ? { amount: "Montant du prêt", rate: "Taux d'intérêt annuel (%)", term: "Durée (années)", calc: "Calculer",
      err: "Saisissez un montant et une durée positifs, et un taux de 0 ou plus.",
      month: "{0} / mois", ti: "Total des intérêts : <strong>{0}</strong>", tr: "Total remboursé : <strong>{0}</strong> en {1} mensualités" }
  : lang === 'es'
  ? { amount: "Importe del préstamo", rate: "Tasa de interés anual (%)", term: "Plazo (años)", calc: "Calcular",
      err: "Introduce un importe y un plazo positivos, y una tasa de 0 o más.",
      month: "{0} / mes", ti: "Total de intereses: <strong>{0}</strong>", tr: "Total devuelto: <strong>{0}</strong> en {1} cuotas" }
  : lang === 'ar'
  ? { amount: 'مبلغ القرض', rate: 'نسبة الفائدة السنوية (%)', term: 'المدة (سنوات)', calc: 'احسب',
      err: 'أدخل مبلغاً ومدة موجبين ونسبة فائدة 0 أو أكثر.',
      month: '{0} / شهرياً', ti: 'إجمالي الفوائد: <strong>{0}</strong>', tr: 'إجمالي المسدّد: <strong>{0}</strong> على {1} قسطاً' }
  : { amount: 'Loan amount', rate: 'Yearly interest rate (%)', term: 'Term (years)', calc: 'Calculate',
      err: 'Enter a positive amount and term, and a rate of 0 or more.',
      month: '{0} / month', ti: 'Total interest: <strong>{0}</strong>', tr: 'Total repaid: <strong>{0}</strong> over {1} payments' };
---
<form id="ln" onsubmit="return false" data-s={JSON.stringify(S)}>
  <div class="row">
    <div><label for="ln-a">{S.amount}</label><input id="ln-a" type="number" min="0" step="any" value="20000" /></div>
    <div><label for="ln-r">{S.rate}</label><input id="ln-r" type="number" min="0" step="any" value="6.5" /></div>
    <div><label for="ln-t">{S.term}</label><input id="ln-t" type="number" min="0.1" step="any" value="5" /></div>
  </div>
  <button id="ln-go" type="button">{S.calc}</button>
  <div class="result" id="ln-out" aria-live="polite"></div>
</form>

<script>
  import { $, money, fill, strings } from '../../lib/util';
  const S = strings('ln');
  function run() {
    const P = parseFloat($('ln-a').value), apr = parseFloat($('ln-r').value), yrs = parseFloat($('ln-t').value);
    const out = $('ln-out');
    if ([P, apr, yrs].some(isNaN) || P <= 0 || yrs <= 0 || apr < 0) { out.textContent = S.err; return; }
    const n = Math.round(yrs * 12), r = apr / 100 / 12;
    const pay = r === 0 ? P / n : (P * r) / (1 - Math.pow(1 + r, -n));
    const total = pay * n;
    out.innerHTML = `<p class="big">${fill(S.month, money(pay))}</p><p>${fill(S.ti, money(total - P))}</p><p>${fill(S.tr, money(total), n)}</p>`;
  }
  $('ln-go').addEventListener('click', run);
  ['ln-a', 'ln-r', 'ln-t'].forEach((id) => $(id).addEventListener('input', run));
  run();
</script>
