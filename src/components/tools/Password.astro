---
const { lang } = Astro.props;
const S = lang === 'fr'
  ? { len: "Longueur", up: "Majuscules (A-Z)", lo: "Minuscules (a-z)", nu: "Chiffres (0-9)", sy: "Symboles (!@#$)", gen: "Générer", copy: "Copier",
      copied: "Copié", err: "Choisissez au moins un type de caractères, et une longueur de 4 à 128." }
  : lang === 'es'
  ? { len: "Longitud", up: "Mayúsculas (A-Z)", lo: "Minúsculas (a-z)", nu: "Números (0-9)", sy: "Símbolos (!@#$)", gen: "Generar", copy: "Copiar",
      copied: "Copiado", err: "Elige al menos un tipo de carácter y una longitud de 4 a 128." }
  : lang === 'ar'
  ? { len: 'الطول', up: 'أحرف كبيرة (A-Z)', lo: 'أحرف صغيرة (a-z)', nu: 'أرقام (0-9)', sy: 'رموز (!@#$)', gen: 'ولّد', copy: 'انسخ',
      copied: 'تم النسخ', err: 'اختر نوعاً واحداً من الأحرف على الأقل، والطول بين 4 و128.' }
  : { len: 'Length', up: 'Uppercase (A-Z)', lo: 'Lowercase (a-z)', nu: 'Numbers (0-9)', sy: 'Symbols (!@#$)', gen: 'Generate', copy: 'Copy',
      copied: 'Copied', err: 'Pick at least one character type, and a length from 4 to 128.' };
---
<form id="pw" onsubmit="return false" data-s={JSON.stringify(S)}>
  <label for="pw-n">{S.len}</label>
  <input id="pw-n" type="number" min="4" max="128" step="1" value="16" />
  <label><input id="pw-u" type="checkbox" checked style="width:auto" /> {S.up}</label>
  <label><input id="pw-l" type="checkbox" checked style="width:auto" /> {S.lo}</label>
  <label><input id="pw-d" type="checkbox" checked style="width:auto" /> {S.nu}</label>
  <label><input id="pw-s" type="checkbox" checked style="width:auto" /> {S.sy}</label>
  <button id="pw-go" type="button">{S.gen}</button>
  <button id="pw-cp" type="button">{S.copy}</button>
  <div class="result" id="pw-out" aria-live="polite"></div>
</form>

<script>
  import { $, strings } from '../../lib/util';
  const S = strings('pw');
  const out = document.getElementById('pw-out')!;
  const sets: [string, string][] = [
    ['pw-u', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'],
    ['pw-l', 'abcdefghijklmnopqrstuvwxyz'],
    ['pw-d', '0123456789'],
    ['pw-s', '!@#$%^&*()-_=+[]{};:,.?'],
  ];
  // Unbiased random integer in [0, max) from the browser's crypto generator
  function rand(max: number) {
    const lim = Math.floor(0x100000000 / max) * max;
    const a = new Uint32Array(1);
    do crypto.getRandomValues(a); while (a[0] >= lim);
    return a[0] % max;
  }
  let current = '';
  function generate() {
    const n = parseInt($('pw-n').value);
    const chosen = sets.filter(([id]) => $(id).checked).map(([, s]) => s);
    if (!chosen.length || isNaN(n) || n < 4 || n > 128) { out.textContent = S.err; current = ''; return; }
    const all = chosen.join('');
    // one from every chosen set first, so each type is present
    const chars = chosen.map((s) => s[rand(s.length)]);
    while (chars.length < n) chars.push(all[rand(all.length)]);
    for (let i = chars.length - 1; i > 0; i--) { const j = rand(i + 1); [chars[i], chars[j]] = [chars[j], chars[i]]; }
    current = chars.join('');
    const p = document.createElement('p');
    p.className = 'big';
    p.dir = 'ltr';
    p.style.wordBreak = 'break-all';
    p.style.fontFamily = 'ui-monospace, Menlo, Consolas, monospace';
    p.style.fontSize = '1.3rem';
    p.textContent = current;
    out.replaceChildren(p);
  }
  $('pw-go').addEventListener('click', generate);
  $('pw-cp').addEventListener('click', async () => {
    if (!current) return;
    try { await navigator.clipboard.writeText(current); $('pw-cp').textContent = S.copied; setTimeout(() => ($('pw-cp').textContent = S.copy), 1500); } catch {}
  });
  generate();
</script>
