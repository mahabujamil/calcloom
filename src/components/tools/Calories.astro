---
import { tr, locale } from '../../lib/t';
const { lang } = Astro.props;
const S = {
  sex: tr(lang, 'Sex', 'الجنس', 'Sexe', 'Sexo'), m: tr(lang, 'Male', 'ذكر', 'Homme', 'Hombre'), f: tr(lang, 'Female', 'أنثى', 'Femme', 'Mujer'),
  age: tr(lang, 'Age (years)', 'العمر (سنة)', 'Âge (ans)', 'Edad (años)'), w: tr(lang, 'Weight (kg)', 'الوزن (كغ)', 'Poids (kg)', 'Peso (kg)'), h: tr(lang, 'Height (cm)', 'الطول (سم)', 'Taille (cm)', 'Estatura (cm)'),
  act: tr(lang, 'Activity level', 'مستوى النشاط', "Niveau d'activité", 'Nivel de actividad'),
  a1: tr(lang, 'Sedentary (little exercise)', 'خامل (قليل الحركة)', "Sédentaire (peu d'exercice)", 'Sedentario (poco ejercicio)'),
  a2: tr(lang, 'Light (1-3 days a week)', 'خفيف (1-3 أيام تمرين)', 'Léger (1 à 3 jours par semaine)', 'Ligero (1-3 días a la semana)'),
  a3: tr(lang, 'Moderate (3-5 days a week)', 'متوسط (3-5 أيام تمرين)', 'Modéré (3 à 5 jours par semaine)', 'Moderado (3-5 días a la semana)'),
  a4: tr(lang, 'Active (6-7 days a week)', 'عالٍ (6-7 أيام تمرين)', 'Actif (6 à 7 jours par semaine)', 'Activo (6-7 días a la semana)'),
  a5: tr(lang, 'Very active (hard physical work)', 'عالٍ جداً (عمل بدني شاق)', 'Très actif (travail physique intense)', 'Muy activo (trabajo físico duro)'),
  err: tr(lang, 'Enter age, weight and height.', 'أدخل العمر والوزن والطول.', "Saisissez l'âge, le poids et la taille.", 'Introduce edad, peso y estatura.'),
  bmr: tr(lang, 'Basal metabolic rate (BMR)', 'معدل الحرق الأساسي (BMR)', 'Métabolisme de base (MB)', 'Metabolismo basal (TMB)'),
  tdee: tr(lang, 'Calories to maintain your weight', 'السعرات اللازمة للحفاظ على وزنك', 'Calories pour maintenir votre poids', 'Calorías para mantener tu peso'),
  lose: tr(lang, 'To lose weight gradually (-500)', 'لإنقاص الوزن تدريجياً (-500)', 'Pour perdre du poids progressivement (-500)', 'Para perder peso gradualmente (-500)'),
  gain: tr(lang, 'To gain weight gradually (+500)', 'لزيادة الوزن تدريجياً (+500)', 'Pour prendre du poids progressivement (+500)', 'Para ganar peso gradualmente (+500)'),
  kc: tr(lang, 'kcal/day', 'سعرة/يوم', 'kcal/jour', 'kcal/día'),
};
---
<form id="cl" onsubmit="return false" data-s={JSON.stringify(S)}>
  <div class="row">
    <div><label for="cl-s">{S.sex}</label><select id="cl-s"><option value="m">{S.m}</option><option value="f">{S.f}</option></select></div>
    <div><label for="cl-a">{S.age}</label><input id="cl-a" type="number" min="10" max="100" value="30" inputmode="numeric" /></div>
  </div>
  <div class="row">
    <div><label for="cl-w">{S.w}</label><input id="cl-w" type="number" step="any" value="75" inputmode="decimal" /></div>
    <div><label for="cl-h">{S.h}</label><input id="cl-h" type="number" step="any" value="175" inputmode="decimal" /></div>
  </div>
  <label for="cl-x">{S.act}</label>
  <select id="cl-x">
    <option value="1.2">{S.a1}</option><option value="1.375">{S.a2}</option><option value="1.55" selected>{S.a3}</option><option value="1.725">{S.a4}</option><option value="1.9">{S.a5}</option>
  </select>
  <div class="result" id="cl-out" aria-live="polite"></div>
</form>
<script>
  import { $, strings, LOC, dec } from '../../lib/util';
  const S = strings('cl');
  const f = (n: number) => Math.round(n).toLocaleString(LOC());
  function run() {
    const a = parseFloat($('cl-a').value), w = parseFloat($('cl-w').value), h = parseFloat($('cl-h').value), out = $('cl-out');
    if (!(a > 0 && w > 0 && h > 0)) { out.textContent = S.err; return; }
    const bmr = 10 * w + 6.25 * h - 5 * a + ($('cl-s').value === 'm' ? 5 : -161);
    const t = bmr * parseFloat($('cl-x').value);
    out.innerHTML = `<p class="big" dir="ltr">${f(t)}</p><p>${S.tdee} (${S.kc})</p><p class="muted" dir="ltr">${S.lose}: ${f(t - 500)} · ${S.gain}: ${f(t + 500)}</p><p class="muted" dir="ltr">${S.bmr}: ${f(bmr)}</p>`;
  }
  document.getElementById('cl')!.addEventListener('input', run);
  document.getElementById('cl')!.addEventListener('change', run);
  run();
</script>
