---
import { tr, locale } from '../../lib/t';
const { lang } = Astro.props;
const S = {
  amount: tr(lang, 'Amount', 'المبلغ', 'Montant', 'Importe'),
  rate: tr(lang, 'Tax rate %', 'نسبة الضريبة %', 'Taux de TVA %', 'Tipo de IVA %'),
  mode: tr(lang, 'Calculation', 'نوع الحساب', 'Type de calcul', 'Tipo de cálculo'),
  add: tr(lang, 'Add tax to the amount', 'إضافة الضريبة إلى المبلغ', 'Ajouter la TVA au montant', 'Añadir el IVA al importe'),
  rem: tr(lang, 'Remove tax from a total', 'استخراج الضريبة من مبلغ شامل', "Retirer la TVA d'un total TTC", 'Quitar el IVA de un total con IVA'),
  net: tr(lang, 'Amount without tax', 'المبلغ بدون ضريبة', 'Montant HT', 'Importe sin IVA'),
  tax: tr(lang, 'Tax amount', 'قيمة الضريبة', 'Montant de la TVA', 'Importe del IVA'),
  gross: tr(lang, 'Amount with tax', 'المبلغ شامل الضريبة', 'Montant TTC', 'Importe con IVA'),
  err: tr(lang, 'Enter the amount and the rate.', 'أدخل المبلغ والنسبة.', 'Saisissez le montant et le taux.', 'Introduce el importe y el tipo.'),
};
---
<form id="vt" onsubmit="return false" data-s={JSON.stringify(S)}>
  <div class="row">
    <div><label for="vt-a">{S.amount}</label><input id="vt-a" type="number" step="any" value="100" inputmode="decimal" /></div>
    <div><label for="vt-r">{S.rate}</label><input id="vt-r" type="number" step="any" value="15" inputmode="decimal" /></div>
  </div>
  <label for="vt-m">{S.mode}</label>
  <select id="vt-m"><option value="add">{S.add}</option><option value="rem">{S.rem}</option></select>
  <div class="result" id="vt-out" aria-live="polite"></div>
</form>
<script>
  import { $, strings, money } from '../../lib/util';
  const S = strings('vt');
  function run() {
    const a = parseFloat($('vt-a').value), r = parseFloat($('vt-r').value), out = $('vt-out');
    if (isNaN(a) || isNaN(r) || r < 0) { out.textContent = S.err; return; }
    const rem = $('vt-m').value === 'rem';
    const net = rem ? a / (1 + r / 100) : a;
    const gross = rem ? a : a * (1 + r / 100);
    out.innerHTML = `<p class="big" dir="ltr">${money(rem ? net : gross)}</p><p>${rem ? S.net : S.gross}</p><p dir="ltr" class="muted">${S.tax}: ${money(gross - net)}</p><p dir="ltr" class="muted">${S.net}: ${money(net)} · ${S.gross}: ${money(gross)}</p>`;
  }
  document.getElementById('vt')!.addEventListener('input', run);
  document.getElementById('vt')!.addEventListener('change', run);
  run();
</script>
