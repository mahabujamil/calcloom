---
import { ucat } from '../../data/units';
import { tr, locale } from '../../lib/t';
const { lang, conv } = Astro.props;
const c = ucat(conv.cat);
const nameOf = (x: any) => tr(lang, x.en, x.ar, x.fr, x.es);
const S = {
  value: tr(lang, 'Value', 'القيمة', 'Valeur', 'Valor'),
  from: tr(lang, 'From', 'من', 'De', 'De'),
  to: tr(lang, 'To', 'إلى', 'Vers', 'A'),
  swap: tr(lang, 'Swap', 'تبديل', 'Inverser', 'Intercambiar'),
  err: tr(lang, 'Enter a number.', 'أدخل رقماً.', 'Saisissez un nombre.', 'Introduce un número.'),
  copy: tr(lang, 'Copy result', 'نسخ النتيجة', 'Copier le résultat', 'Copiar resultado'),
  formula: '1 {0} = {1} {2}',
  from0: conv.from,
  to0: conv.to,
  units: c.units.map((x) => [x.id, `${nameOf(x)} (${x.sym})`, x.f, x.sym]),
};
---
<form id="cv" onsubmit="return false" data-s={JSON.stringify(S)}>
  <div class="cv-grid">
    <div><label for="cv-v">{S.value}</label><input id="cv-v" type="number" step="any" value="1" inputmode="decimal" /></div>
    <div><label for="cv-a">{S.from}</label><select id="cv-a"></select></div>
    <button id="cv-sw" type="button" class="swap" aria-label={S.swap} title={S.swap}>⇄</button>
    <div><label for="cv-b">{S.to}</label><select id="cv-b"></select></div>
  </div>
  <div class="cv-quick">
    {[1, 5, 10, 50, 100, 1000].map((n) => <button type="button" data-q={n}>{n}</button>)}
    <button type="button" class="copy" id="cv-copy">{S.copy}</button>
  </div>
  <div class="result" id="cv-out" aria-live="polite"></div>
</form>

<script>
  import { $, fill, strings , LOC, dec } from '../../lib/util';
  const S = strings('cv');
  const units = S.units as [string, string, number, string][];
  const a = $('cv-a') as unknown as HTMLSelectElement, b = $('cv-b') as unknown as HTMLSelectElement;
  for (const el of [a, b]) el.replaceChildren(...units.map(([id, label]) => new Option(label, id)));
  a.value = S.from0; b.value = S.to0;
  const f = (id: string) => units.find((u) => u[0] === id)!;
  const fmt = (n: number) => Number(n.toPrecision(8)).toLocaleString(LOC(), { maximumFractionDigits: 12 });
  function run() {
    const out = $('cv-out');
    const v = parseFloat($('cv-v').value);
    if (isNaN(v)) { out.textContent = S.err; return; }
    const A = f(a.value), B = f(b.value);
    const r = A[2] / B[2];
    out.innerHTML = `<p class="big" dir="ltr">${fmt(v * r)} ${B[3]}</p>${v === 1 ? "" : `<p dir="ltr">${fmt(v)} ${A[3]} = ${fmt(v * r)} ${B[3]}</p>`}<p dir="ltr" class="muted">${fill(S.formula, A[3], fmt(r), B[3])}</p>`;
  }
  $('cv-sw').addEventListener('click', () => { const t = a.value; a.value = b.value; b.value = t; run(); });
  [a, b].forEach((el) => el.addEventListener('change', run));
  $('cv-v').addEventListener('input', run);
  document.querySelectorAll<HTMLButtonElement>('.cv-quick [data-q]').forEach((el) => el.addEventListener('click', () => { $('cv-v').value = el.dataset.q!; run(); }));
  const cp = $('cv-copy');
  const cpLabel = cp.textContent;
  cp.addEventListener('click', async () => {
    const txt = ($('cv-out').querySelector('.big') as HTMLElement | null)?.textContent ?? '';
    try { await navigator.clipboard.writeText(txt); cp.textContent = '✓'; setTimeout(() => (cp.textContent = cpLabel), 1200); } catch {}
  });
  run();
</script>
