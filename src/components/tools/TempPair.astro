---
const { lang, temp } = Astro.props;
import { tr, locale } from '../../lib/t';
const N = {
  c: { l: tr(lang, 'Celsius', 'مئوي', 'Celsius', 'Celsius'), s: '°C' },
  f: { l: tr(lang, 'Fahrenheit', 'فهرنهايت', 'Fahrenheit', 'Fahrenheit'), s: '°F' },
  k: { l: tr(lang, 'Kelvin', 'كلفن', 'Kelvin', 'Kelvin'), s: 'K' },
};
const S = {
  err: tr(lang, 'Enter a number.', 'أدخل رقماً.', 'Saisissez un nombre.', 'Introduce un número.'),
  low: tr(lang, 'Below absolute zero, enter a higher value.', 'أقل من الصفر المطلق، أدخل قيمة أعلى.', 'Inférieur au zéro absolu, saisissez une valeur plus élevée.', 'Por debajo del cero absoluto, introduce un valor mayor.'),
  swap: tr(lang, 'Swap', 'تبديل', 'Inverser', 'Intercambiar'),
  copy: tr(lang, 'Copy result', 'نسخ النتيجة', 'Copier le résultat', 'Copiar resultado'),
  fromL: tr(lang, 'From', 'من', 'De', 'De'),
  toL: tr(lang, 'To', 'إلى', 'Vers', 'A'),
  from: temp.from,
  to: temp.to,
  N,
};
---
<form id="tp" onsubmit="return false" data-s={JSON.stringify(S)}>
  <div class="cv-grid">
    <div><label for="tp-v" id="tp-vl"></label><input id="tp-v" type="number" step="any" value="25" inputmode="decimal" /></div>
    <div><label>{S.fromL}</label><output id="tp-a" class="unit-out"></output></div>
    <button id="tp-sw" type="button" class="swap" aria-label={S.swap} title={S.swap}>⇄</button>
    <div><label>{S.toL}</label><output id="tp-b" class="unit-out"></output></div>
  </div>
  <div class="cv-quick">
    <button type="button" class="copy" id="tp-copy">{S.copy}</button>
  </div>
  <div class="result" id="tp-out" aria-live="polite"></div>
</form>

<script>
  import { $, strings } from '../../lib/util';
  const S = strings('tp');
  let from: 'c' | 'f' | 'k' = S.from, to: 'c' | 'f' | 'k' = S.to;
  const toC = (u: string, v: number) => (u === 'c' ? v : u === 'f' ? ((v - 32) * 5) / 9 : v - 273.15);
  const fromC = (u: string, c: number) => (u === 'c' ? c : u === 'f' ? (c * 9) / 5 + 32 : c + 273.15);
  const r = (n: number) => String(Number(n.toFixed(4)));
  function labels() {
    $('tp-a').textContent = `${S.N[from].l} (${S.N[from].s})`;
    $('tp-b').textContent = `${S.N[to].l} (${S.N[to].s})`;
    document.getElementById('tp-vl')!.textContent = S.N[from].l;
  }
  function run() {
    const out = $('tp-out');
    const v = parseFloat($('tp-v').value);
    if (isNaN(v)) { out.textContent = S.err; return; }
    const c = toC(from, v);
    if (c < -273.15 - 1e-9) { out.textContent = S.low; return; }
    const res = fromC(to, c);
    out.innerHTML = `<p class="big" dir="ltr">${r(res)} ${S.N[to].s}</p><p dir="ltr">${r(v)} ${S.N[from].s} = ${r(res)} ${S.N[to].s}</p>`;
  }
  $('tp-sw').addEventListener('click', () => { [from, to] = [to, from]; labels(); run(); });
  $('tp-v').addEventListener('input', run);
  const cp = $('tp-copy'); const label = cp.textContent;
  cp.addEventListener('click', async () => {
    const txt = ($('tp-out').querySelector('.big') as HTMLElement | null)?.textContent ?? '';
    try { await navigator.clipboard.writeText(txt); cp.textContent = '✓'; setTimeout(() => (cp.textContent = label), 1200); } catch {}
  });
  labels(); run();
</script>
