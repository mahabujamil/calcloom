---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { tools } from '../data/tools';
import { allTools, getTool } from '../data/get';
import { meta, cats, type Cat } from '../data/meta';
import { ui, localePath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const ar = lang === 'ar';
const list = allTools(lang).filter((x) => x.kind !== 'pair');
const topSlugs = ['currency-converter', 'percentage-calculator', 'age-calculator', 'bmi-calculator', 'gpa-calculator', 'loan-calculator', 'date-calculator', 'vat-calculator', 'calorie-calculator', 'length-converter', 'weight-converter', 'days-between-dates-calculator'];
const top = topSlugs.map((x) => getTool(x, lang));
const featured = ['usd-to-egp', 'usd-to-sar', 'eur-to-usd', 'celsius-to-fahrenheit', 'fahrenheit-to-celsius', 'days-until-christmas', 'days-until-ramadan', 'days-until-new-year', 'days-until-black-friday'];
const popular = [...featured, ...tools.filter((x) => x.kind === 'pair' && !featured.includes(x.slug)).slice(0, 12).map((x) => x.slug)].map((s) => getTool(s, lang));
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Calcloom', url: Astro.site?.href, inLanguage: lang },
];
const L = ar
  ? { badge: 'مجاني 100% · بدون تسجيل', h1a: 'كل حاسبة ومحوّل تحتاجه،', h1b: 'بسرعة ودقة.', search: 'ابحث عن حاسبة أو محوّل...', all: 'الكل',
      none: 'ما لقينا أداة بهذا الاسم.', t1: 'مجاني دائماً', t2: 'بدون تسجيل', t3: 'بياناتك لا تُخزَّن', t4: 'عربي وإنجليزي',
      wTitle: 'كيلومتر إلى ميل', wFrom: 'كيلومتر', wTo: 'ميل', wMore: 'كل محوّلات الطول ←', pop: 'تحويلات شائعة', top: 'الأكثر طلباً' }
  : { badge: '100% free · No sign-up', h1a: 'Every calculator and converter you need.', h1b: 'Fast.', search: 'Search calculators and converters...', all: 'All',
      none: 'No tool matches that search.', t1: 'Free forever', t2: 'No sign-up', t3: 'Your data is never stored', t4: 'English and Arabic',
      wTitle: 'Kilometres to Miles', wFrom: 'Kilometres', wTo: 'Miles', wMore: 'All length converters →', pop: 'Popular conversions', top: 'Most requested' };
const lenSlug = localePath(lang, '/length-converter/');
---
<Base title={t.homeTitle} description={t.homeDesc} {lang} {schema}>
  <section class="hero">
    <div class="hero-grid">
      <div>
        <span class="badge"><i></i>{L.badge}</span>
        <h1>{L.h1a} <em>{L.h1b}</em></h1>
        <p class="lead">{t.homeLead}</p>
        <div class="search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          <input id="q" type="search" placeholder={L.search} aria-label={L.search} autocomplete="off" />
        </div>
        <div class="quick" aria-label={L.pop}>
          {popular.slice(0, 6).map((p) => <a href={localePath(lang, `/${p.slug}/`)}>{p.name}</a>)}
        </div>
        <div class="trust"><span>{L.t1}</span><span>{L.t2}</span><span>{L.t3}</span><span>{L.t4}</span></div>
      </div>
      <div class="widget">
        <h2>{L.wTitle}</h2>
        <div class="wrow">
          <div><label for="w-a">{L.wFrom}</label><input id="w-a" type="number" value="10" step="any" inputmode="decimal" /></div>
          <span class="eq">=</span>
          <div><label>{L.wTo}</label><output id="w-b" dir="ltr">6.2137</output></div>
        </div>
        <a class="more" href={lenSlug}>{L.wMore}</a>
      </div>
    </div>
  </section>

  <h2 class="reveal">{L.top}</h2>
  <div class="grid top">
    {top.map((tool) => (
      <a class="tile in" href={localePath(lang, `/${tool.slug}/`)}>
        <Icon slug={tool.slug} />
        <div class="tx">
          <strong>{tool.name}</strong>
          <span class="d">{tool.intro}</span>
        </div>
      </a>
    ))}
  </div>

  <h2 class="reveal">{t.allCalcs}</h2>
  <div class="chips reveal" role="group" aria-label={t.allCalcs}>
    <button class="chip" type="button" data-cat="all" aria-pressed="true">{L.all}</button>
    {(Object.keys(cats) as Cat[]).map((c) => (
      <button class="chip" type="button" data-cat={c} aria-pressed="false">{ar ? cats[c].ar : cats[c].en}</button>
    ))}
  </div>
  <div class="grid" id="grid">
    {list.map((tool, i) => (
      <a class="tile reveal" style={`--d:${(i % 6) * 0.04}s`} href={localePath(lang, `/${tool.slug}/`)} data-cat={meta[tool.slug].cat} data-name={tool.name.toLowerCase()}>
        <Icon slug={tool.slug} />
        <div class="tx">
          <strong>{tool.name}</strong>
          <span class="d">{tool.intro}</span>
        </div>
      </a>
    ))}
  </div>
  <p class="empty hidden" id="empty">{L.none}</p>

  <h2 class="reveal">{L.pop}</h2>
  <div class="pills reveal">
    {popular.map((p) => <a href={localePath(lang, `/${p.slug}/`)}>{p.name}</a>)}
  </div>
</Base>

<script>
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('#grid .tile'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const q = document.getElementById('q') as HTMLInputElement;
  const empty = document.getElementById('empty')!;
  let cat = 'all';
  function apply() {
    const s = q.value.trim().toLowerCase();
    let shown = 0;
    for (const el of tiles) {
      const ok = (cat === 'all' || el.dataset.cat === cat) && (!s || el.dataset.name!.includes(s));
      el.classList.toggle('hidden', !ok);
      if (ok) { shown++; el.classList.add('in'); }
    }
    empty.classList.toggle('hidden', shown > 0);
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    cat = c.dataset.cat!;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    apply();
  }));
  q.addEventListener('input', apply);

  // category from the sidebar link (/#money)
  const sideLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.side-nav a.cat'));
  function fromHash() {
    const id = location.hash.slice(1);
    const valid = chips.some((c) => c.dataset.cat === id);
    cat = valid ? id : 'all';
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.cat === cat)));
    sideLinks.forEach((a, i) => a.classList.toggle('on', cat === 'all' ? i === 0 : a.getAttribute('href')!.endsWith('#' + cat)));
    apply();
    if (valid) document.getElementById('grid')?.scrollIntoView();
  }
  window.addEventListener('hashchange', fromHash);
  fromHash();

  const wa = document.getElementById('w-a') as HTMLInputElement;
  const wb = document.getElementById('w-b')!;
  function conv() {
    const v = parseFloat(wa.value);
    wb.textContent = isNaN(v) ? '—' : Number((v * 0.621371).toPrecision(8)).toLocaleString('en-US', { maximumFractionDigits: 8 });
  }
  wa.addEventListener('input', conv);
  conv();
</script>
