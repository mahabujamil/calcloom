---
import Base from '../layouts/Base.astro';
import { localePath } from '../i18n';
const links: [string, string, string][] = [
  ['km-to-miles', 'Kilometres to Miles', 'كيلومتر إلى ميل'],
  ['kg-to-pounds', 'Kilograms to Pounds', 'كيلوغرام إلى رطل'],
  ['loan-calculator', 'Loan Calculator', 'حاسبة القروض'],
  ['bmi-calculator', 'BMI Calculator', 'حاسبة BMI'],
];
---
<Base title="Page not found | Calcloom" description="This page does not exist. Browse our free calculators and unit converters." noindex>
  <h1>Page not found</h1>
  <p class="lead">The page you are looking for does not exist or has moved.</p>
  <p><a href={localePath('en', '/')}>← Back to all calculators</a></p>
  <h2 dir="rtl" lang="ar">الصفحة غير موجودة</h2>
  <p dir="rtl" lang="ar"><a href={localePath('ar', '/')}>← العودة إلى كل الحاسبات</a></p>
  <div class="pills" style="margin-top:20px">
    {links.map((l) => <a href={localePath('en', `/${l[0]}/`)}>{l[1]}</a>)}
    {links.map((l) => <a lang="ar" dir="rtl" href={localePath('ar', `/${l[0]}/`)}>{l[2]}</a>)}
  </div>
</Base>
